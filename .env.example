# Сервис
SERVICE_NAME=chrome_skill
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=30s

# Порты: публичный API и служебный (пробы, pprof)
PORT=8080
DEBUG_PORT=8081

# База данных
DATABASE_URL=postgres://chrome_skill:chrome_skill@localhost:5432/chrome_skill?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_CONN_MAX_LIFETIME=30m

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Статика фронта, которую бэкенд раздаёт с диска (выход сборки Vite)
STATIC_DIR=front/public
