# Фронт собирается здесь же: сервис — монолит, он раздаёт собранный SPA с диска,
# поэтому образ без front/public отдавал бы только API.
FROM node:22-alpine AS front
WORKDIR /front
COPY front/package.json front/package-lock.json ./
RUN npm ci
COPY front/ ./
RUN npm run build

FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Миграции вшиты в бинарь migrator (internal/db/embed.go), поэтому каталог
# с .sql в рантайм-образ не копируется.
RUN CGO_ENABLED=0 go build -o /server ./cmd/server && \
    CGO_ENABLED=0 go build -o /migrator ./cmd/migrator

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /server /server
COPY --from=builder /migrator /migrator
COPY --from=front /front/public /srv/public
ENV STATIC_DIR=/srv/public
EXPOSE 8080 8081
CMD ["/server"]
