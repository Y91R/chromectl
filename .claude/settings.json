{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-gen.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
