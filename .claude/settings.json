{
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": false
  },
  "permissions": {
    "allow": [
      "Bash(./build/chromectl:*)",
      "Bash(chromectl:*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
